<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootCrearCategoria"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/bg_card_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#44FFFFFF"/>

        <TextView
            android:id="@+id/txtCrearCatTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crear_cat_titulo"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/editCategoriaNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/crear_cat_nombre_hint"
            android:textColor="@android:color/white"
            android:textColorHint="#88FFFFFF"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_main"
            android:padding="12dp"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/editCategoriaEmoji"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/crear_cat_emoji_hint"
            android:textColor="@android:color/white"
            android:textColorHint="#88FFFFFF"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card_main"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crear_cat_palabras_titulo"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/llPalabras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnAgregarPalabra"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/crear_cat_agregar_palabra"
            android:textAllCaps="false"
            android:textColor="#CCFFFFFF"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnGuardarCategoria"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/guardar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
