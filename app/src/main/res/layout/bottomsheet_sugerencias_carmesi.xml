<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSugerencias"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_carmesi_sheet"
    android:fillViewport="true"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <View
        android:layout_width="56dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_carmesi_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBackSugerencias"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_carmesi_toolbar_button"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/carmesi_text_primary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/txtTituloSugerencias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="@string/sug_titulo"
            android:textColor="@color/carmesi_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/sug_desc"
        android:textColor="@color/carmesi_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sug_carmesi_helper"
        android:textColor="@color/carmesi_text_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/editEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_carmesi_input"
        android:hint="@string/sug_email_hint"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:textColor="@color/carmesi_text_primary"
        android:textColorHint="@color/carmesi_text_muted"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/editSugerencia"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_carmesi_input"
        android:gravity="top|start"
        android:hint="@string/sug_texto_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="5"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:textColor="@color/carmesi_text_primary"
        android:textColorHint="@color/carmesi_text_muted"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnEnviarSugerencia"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_neon_red"
        android:backgroundTint="@null"
        android:fontFamily="sans-serif-medium"
        android:text="@string/sug_enviar"
        android:textAllCaps="false"
        android:textColor="@color/carmesi_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
