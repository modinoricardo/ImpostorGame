<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- ═══════════════════════════════════════════════════
         "¡IMPOSTOR!" — invisible hasta la fase 3.
         Está sobre la escena de personajes.
         visibility=invisible (ocupa espacio) para no
         desplazar el layout cuando aparece.
    ════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvImpostor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.12"
        android:text="¡IMPOSTOR!"
        android:textColor="#FF1744"
        android:textSize="36sp"
        android:textStyle="bold"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/sceneContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.75" />

    <!-- ═══════════════════════════════════════════════════
         Escena: fila de flechas + fila de personajes.
         Posicionada al 40% vertical de la pantalla.
    ════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/sceneContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/titleText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.40">

        <!-- Fila de flechas (apuntan hacia el impostor, índice 3) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:orientation="horizontal">

            <!-- Flechas izquierda → derecha (crew 0,1,2 acusan al impostor) -->
            <ImageView
                android:id="@+id/arrow0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_right"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/arrow1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_right"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/arrow2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_right"
                android:visibility="invisible" />

            <!-- Espacio sobre el impostor (sin flecha) -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Flechas derecha → izquierda (crew 4,5 acusan al impostor) -->
            <ImageView
                android:id="@+id/arrow4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleX="-1"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_right"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/arrow5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleX="-1"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_right"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- Fila de personajes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/char0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/civil1" />

            <ImageView
                android:id="@+id/char1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/civil2" />

            <ImageView
                android:id="@+id/char2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/civil3" />

            <!-- Impostor (índice 3, centro) -->
            <ImageView
                android:id="@+id/char3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/impostor" />

            <ImageView
                android:id="@+id/char4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/civil4" />

            <ImageView
                android:id="@+id/char5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/civil5" />

        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════
         Título del juego
    ════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.22"
        android:text="EL IMPOSTOR"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/loadingContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sceneContainer"
        app:layout_constraintVertical_bias="0.4" />

    <!-- ═══════════════════════════════════════════════════
         Barra de carga.
         - loadingTrack: pista (fondo oscuro).
         - loadingFill:  relleno (scaleX 0→1, pivotX izquierda).
         - loadingIcon:  imagen del impostor que avanza.
         La altura del contenedor (60dp) acomoda el icono
         (40dp) y la barra (12dp) con margen.
    ════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/loadingContainer"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Pista (barra completa como fondo) -->
        <View
            android:id="@+id/loadingTrack"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_loading_track" />

        <!-- Relleno (scaleX se anima de 0 a 1, pivotX = 0) -->
        <View
            android:id="@+id/loadingFill"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_loading_fill"
            android:scaleX="0" />

        <!-- Icono del impostor que se mueve con la barra -->
        <ImageView
            android:id="@+id/loadingIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="start|bottom"
            android:layout_marginBottom="18dp"
            android:src="@drawable/impostor"
            android:scaleType="fitCenter" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
