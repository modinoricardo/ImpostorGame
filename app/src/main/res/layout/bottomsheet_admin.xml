<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootAdmin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@drawable/bg_card_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="#44FFFFFF"/>

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/txtAdminTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/admin_titulo"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAdminLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/admin_logout"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- Sección: Categorías de palabras -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_sec_palabras"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAdminNuevaCat"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/admin_nueva_cat"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/llAdminCats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <!-- Sección: Datos curiosos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_sec_datos"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAdminNuevaFactCat"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/admin_nueva_fact_cat"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/llAdminFactCats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <!-- Publicar contenido base -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnAdminPublicarSeed"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/admin_publicar_seed"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
