<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon_space_deep_terminal"
    tools:context=".activities.MainActivity">

    <ImageView
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="center"
        android:alpha="0.06"
        android:contentDescription="@null"
        android:src="@drawable/ic_letra_s" />

    <View android:id="@+id/aurora" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.35" android:background="@drawable/overlay_aurora" />
    <View android:id="@+id/ring1" android:layout_width="280dp" android:layout_height="280dp" android:alpha="0.38" android:background="@drawable/ring_neon_deep_terminal" android:layout_gravity="center" />
    <View android:id="@+id/ring2" android:layout_width="400dp" android:layout_height="400dp" android:alpha="0.18" android:background="@drawable/ring_neon_deep_terminal_soft" android:layout_gravity="center" />

    <TextView
        android:id="@+id/btnMenu"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_chip_deep_terminal"
        android:text="..."
        android:textSize="24sp"
        android:textColor="#FFF4F0F2"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:elevation="8dp" />

    <ScrollView android:id="@+id/scrollContent" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:paddingBottom="104dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="72dp"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="@string/staicy_edition"
                android:textColor="#B5F0D0D7"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:text="@string/main_title"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:shadowColor="#66D92C58"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="18" />

            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="18dp"
                android:background="#76F0D0D7" />

            <!-- CardView Jugadores -->
            <androidx.cardview.widget.CardView android:id="@+id/cardViewModoJuego" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:cardMaxElevation="0dp" app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@android:color/transparent">
                <RelativeLayout android:id="@+id/relativeLayoutJugadores" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:background="@drawable/bg_card_main_deep_terminal">
                    <TextView android:id="@+id/textTituloJugadores" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_marginBottom="12dp" android:layout_toStartOf="@id/imageViewArrow" android:fontFamily="serif" android:text="@string/main_edit_players" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/imageViewArrow" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/chevron_right_24" app:tint="#F0D0D7" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/playersRecyclerView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/textTituloJugadores" android:layout_toStartOf="@id/imageViewArrow" android:nestedScrollingEnabled="false" android:overScrollMode="never" android:padding="0dp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- CardView NÃƒÂºmero de Impostores -->
            <androidx.cardview.widget.CardView android:id="@+id/cardViewNumImpostores" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:cardMaxElevation="0dp" app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@android:color/transparent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card_main_deep_terminal">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:text="@string/main_num_impostores" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/white" />
                            <TextView android:id="@+id/txtResumenImpostores" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textSize="13sp" android:textColor="#CCFFFFFF" />
                        </LinearLayout>
                        <TextView android:id="@+id/btnMenosImpostores" android:layout_width="36dp" android:layout_height="36dp" android:text="-" android:textSize="22sp" android:textColor="@android:color/white" android:gravity="center" android:background="@drawable/btn_neon_deep_terminal" android:textStyle="bold" android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/txtNumImpostores" android:layout_width="40dp" android:layout_height="wrap_content" android:text="1" android:textSize="20sp" android:textColor="@android:color/white" android:textStyle="bold" android:gravity="center" />
                        <TextView android:id="@+id/btnMasImpostores" android:layout_width="36dp" android:layout_height="36dp" android:text="+" android:textSize="22sp" android:textColor="@android:color/white" android:gravity="center" android:background="@drawable/btn_neon_deep_terminal" android:textStyle="bold" android:clickable="true" android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CardView SeÃƒÂ±ores Blancos -->
            <androidx.cardview.widget.CardView android:id="@+id/cardViewNumSenoresBlancos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" android:visibility="gone" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:cardMaxElevation="0dp" app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@android:color/transparent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card_main_deep_terminal">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:text="@string/main_senores_blancos" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/white" />
                            <TextView android:id="@+id/txtResumenSenoresBlancos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textSize="13sp" android:textColor="#CCFFFFFF" />
                        </LinearLayout>
                        <TextView android:id="@+id/btnMenosSenoresBlancos" android:layout_width="36dp" android:layout_height="36dp" android:text="-" android:textSize="22sp" android:textColor="@android:color/white" android:gravity="center" android:background="@drawable/btn_neon_deep_terminal" android:textStyle="bold" android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/txtNumSenoresBlancos" android:layout_width="40dp" android:layout_height="wrap_content" android:text="1" android:textSize="20sp" android:textColor="@android:color/white" android:textStyle="bold" android:gravity="center" />
                        <TextView android:id="@+id/btnMasSenoresBlancos" android:layout_width="36dp" android:layout_height="36dp" android:text="+" android:textSize="22sp" android:textColor="@android:color/white" android:gravity="center" android:background="@drawable/btn_neon_deep_terminal" android:textStyle="bold" android:clickable="true" android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CardView CategorÃƒÂ­as -->
            <androidx.cardview.widget.CardView android:id="@+id/cardViewCategorias" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:cardMaxElevation="0dp" app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@android:color/transparent">
                <RelativeLayout android:id="@+id/relativeLayoutCategorias" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:background="@drawable/bg_card_main_deep_terminal">
                    <ImageView android:id="@+id/imageViewArrowCategorias" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/chevron_right_24" app:tint="#F0D0D7" />
                    <TextView android:id="@+id/textTituloCategorias" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:layout_toStartOf="@id/imageViewArrowCategorias" android:fontFamily="serif" android:text="@string/main_categorias" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/white" />
                    <TextView android:id="@+id/textResumenCategorias" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/textTituloCategorias" android:layout_toStartOf="@id/imageViewArrowCategorias" android:text="" android:textSize="14sp" android:textColor="#CCFFFFFF" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/categoriesRecyclerView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/textResumenCategorias" android:layout_toStartOf="@id/imageViewArrowCategorias" android:nestedScrollingEnabled="false" android:overScrollMode="never" android:paddingTop="8dp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- CardView CategorÃ­as Datos Curiosos -->
            <androidx.cardview.widget.CardView android:id="@+id/cardViewCategoriasDatos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" android:clickable="true" android:focusable="true" android:visibility="gone" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:cardMaxElevation="0dp" app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@android:color/transparent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/bg_card_main_deep_terminal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:fontFamily="serif" android:text="@string/main_categorias" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/white" />
                        <TextView android:id="@+id/textResumenCategoriasDatos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#CCFFFFFF" />
                    </LinearLayout>
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/chevron_right_24" app:tint="#F0D0D7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CardView Modo de Juego -->
            <androidx.cardview.widget.CardView android:id="@+id/cardViewSeleccionModo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:cardMaxElevation="0dp" app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@android:color/transparent">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:background="@drawable/bg_card_main_deep_terminal">
                    <ImageView android:id="@+id/imageViewArrowModo" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/chevron_right_24" app:tint="#F0D0D7" />
                    <TextView android:id="@+id/txtModoJuegoTitulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toStartOf="@id/imageViewArrowModo" android:fontFamily="serif" android:text="@string/main_modo_juego" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/white" />
                    <TextView android:id="@+id/txtModoJuegoSeleccionado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/txtModoJuegoTitulo" android:layout_toStartOf="@id/imageViewArrowModo" android:layout_marginTop="4dp" android:text="@string/main_modo_clasico" android:textSize="14sp" android:textColor="#CCFFFFFF" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- CardView Ayuda al impostor (dos opciones excluyentes) -->
            <androidx.cardview.widget.CardView android:id="@+id/cardViewPistaImpostor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:cardMaxElevation="0dp" app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@android:color/transparent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card_main_deep_terminal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:text="@string/main_ayuda_impostor" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/white" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:text="@string/main_ayuda_impostor_desc" android:textSize="13sp" android:textColor="#CCFFFFFF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <!-- OpciÃƒÂ³n: Pista completa -->
                        <androidx.cardview.widget.CardView android:id="@+id/cardOpcionPistaCompleta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardMaxElevation="0dp" app:cardBackgroundColor="@android:color/transparent">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_card_main_deep_terminal">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/main_pista" android:textSize="15sp" android:textStyle="bold" android:textColor="@android:color/white" />
                                    <TextView android:id="@+id/checkPistaCompleta" android:layout_width="20dp" android:layout_height="20dp" android:text="&#10003;" android:textSize="15sp" android:textColor="#F3D3DA" android:textStyle="bold" android:gravity="center" android:visibility="visible" />
                                </LinearLayout>
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/main_pista_desc" android:textSize="11sp" android:textColor="#CCFFFFFF" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                        <!-- OpciÃƒÂ³n: Primera letra -->
                        <androidx.cardview.widget.CardView android:id="@+id/cardOpcionPrimeraLetra" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardMaxElevation="0dp" app:cardBackgroundColor="@android:color/transparent">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_card_main_deep_terminal">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/main_primera_letra" android:textSize="15sp" android:textStyle="bold" android:textColor="@android:color/white" />
                                    <TextView android:id="@+id/checkPrimeraLetra" android:layout_width="20dp" android:layout_height="20dp" android:text="&#10003;" android:textSize="15sp" android:textColor="#F3D3DA" android:textStyle="bold" android:gravity="center" android:visibility="gone" />
                                </LinearLayout>
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/main_primera_letra_desc" android:textSize="11sp" android:textColor="#CCFFFFFF" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CardView Todos impostores -->
            <androidx.cardview.widget.CardView android:id="@+id/cardViewModoLoco" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:cardMaxElevation="0dp" app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@android:color/transparent">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:background="@drawable/bg_card_main_deep_terminal">
                    <TextView android:id="@+id/txtModoLocoTitulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:text="@string/main_todos_impostores" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/white" />
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchModoLoco" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:checked="false" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_below="@id/txtModoLocoTitulo" android:text="@string/main_todos_impostores_desc" android:textSize="13sp" android:textColor="#CCFFFFFF" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- CardView Tiempo Limitado -->
            <androidx.cardview.widget.CardView android:id="@+id/cardViewTiempoLimitado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:cardMaxElevation="0dp" app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@android:color/transparent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card_main_deep_terminal">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:text="@string/main_tiempo_limitado" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/white" />
                            <TextView android:id="@+id/txtResumenTiempo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/main_tiempo_limitado_desc" android:textSize="13sp" android:textColor="#CCFFFFFF" />
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchTiempoLimitado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" />
                    </LinearLayout>
                    <!-- Selector de minutos, visible solo si switch activo -->
                    <LinearLayout android:id="@+id/layoutSelectorMinutos" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp" android:visibility="gone">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/main_duracion" android:textSize="15sp" android:textColor="@android:color/white" />
                        <TextView android:id="@+id/btnMenosMinutos" android:layout_width="36dp" android:layout_height="36dp" android:text="-" android:textSize="22sp" android:textColor="@android:color/white" android:gravity="center" android:background="@drawable/btn_neon_deep_terminal" android:textStyle="bold" android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/txtNumMinutos" android:layout_width="60dp" android:layout_height="wrap_content" android:text="" android:textSize="16sp" android:textColor="@android:color/white" android:textStyle="bold" android:gravity="center" />
                        <TextView android:id="@+id/btnMasMinutos" android:layout_width="36dp" android:layout_height="36dp" android:text="+" android:textSize="22sp" android:textColor="@android:color/white" android:gravity="center" android:background="@drawable/btn_neon_deep_terminal" android:textStyle="bold" android:clickable="true" android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CardView CÃƒÂ¡mara -->
            <androidx.cardview.widget.CardView android:id="@+id/cardViewCamara" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:cardMaxElevation="0dp" app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@android:color/transparent">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:background="@drawable/bg_card_main_deep_terminal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:text="@string/main_selfie" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/white" android:id="@+id/txtCamaraTitulo"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchCamara" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:checked="false" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/txtCamaraTitulo" android:layout_marginTop="6dp" android:layout_toStartOf="@id/switchCamara" android:text="@string/main_selfie_desc" android:textSize="13sp" android:textColor="#CCFFFFFF" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btnStartGame" android:layout_width="match_parent" android:layout_height="54dp" android:layout_gravity="bottom" android:layout_margin="16dp" android:background="@drawable/btn_neon_deep_terminal" android:backgroundTint="@null" app:backgroundTint="@null" android:fontFamily="sans-serif-medium" android:text="@string/main_btn_start" android:textAllCaps="true" android:textColor="@android:color/white" android:textStyle="bold" />

    <View android:id="@+id/darkOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#80000000" android:visibility="gone" />

</FrameLayout>


