<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSugerencias"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_reveal_content">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="#4400E5FF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/btnBackSugerencias"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#00E5FF"
            android:textSize="30sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/txtTituloSugerencias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="40dp"
            android:gravity="center"
            android:text="@string/sug_titulo"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:shadowColor="#00E5FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/sug_desc"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/edittext_rounded"
        android:hint="@string/sug_email_hint"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:padding="16dp"
        android:textColor="@android:color/white"
        android:textColorHint="#77FFFFFF"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/editSugerencia"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/edittext_rounded"
        android:gravity="top|start"
        android:hint="@string/sug_texto_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="5"
        android:padding="16dp"
        android:scrollbars="vertical"
        android:textColor="@android:color/white"
        android:textColorHint="#77FFFFFF"
        android:textSize="15sp"
        android:overScrollMode="always" />

    <Button
        android:id="@+id/btnEnviarSugerencia"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_final"
        android:text="@string/sug_enviar"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Space android:layout_width="match_parent" android:layout_height="48dp" />

</LinearLayout>
