<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSugerencias"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_card_main">

    <!-- Handle visual (mismo estilo que el resto de bottom sheets) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="#44FFFFFF" />

    <!-- Fila superior: botón atrás + título centrado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/btnBackSugerencias"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/txtTituloSugerencias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="40dp"
            android:gravity="center"
            android:text="Sugerir mejoras"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:shadowColor="#00E5FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

    </LinearLayout>

    <!-- Subtítulo descriptivo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="¿Tienes una idea o encuentras algo mejorable?\nCuéntanoslo, toda opinión ayuda."
        android:textColor="#CCFFFFFF"
        android:textSize="14sp" />

    <!-- Campo email (opcional, persiste entre sesiones) -->
    <EditText
        android:id="@+id/editEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/edittext_rounded"
        android:hint="Tu correo (opcional)"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:padding="16dp"
        android:textColor="@android:color/white"
        android:textColorHint="#77FFFFFF"
        android:textSize="15sp" />

    <!-- Campo de texto multilínea -->
    <EditText
        android:id="@+id/editSugerencia"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/edittext_rounded"
        android:gravity="top|start"
        android:hint="Escribe aquí tu sugerencia o mejora para la app…"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="5"
        android:padding="16dp"
        android:scrollbars="vertical"
        android:textColor="@android:color/white"
        android:textColorHint="#77FFFFFF"
        android:textSize="15sp"
        android:overScrollMode="always" />

    <!-- Botón Enviar (lógica de envío se implementará en el siguiente paso) -->
    <Button
        android:id="@+id/btnEnviarSugerencia"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_neon"
        android:text="Enviar"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="48dp" />

</LinearLayout>
