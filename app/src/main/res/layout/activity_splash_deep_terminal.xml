<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient_deep_terminal">

    <ImageView
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:alpha="0.08"
        android:contentDescription="@null"
        android:src="@drawable/ic_letra_s_carmesi"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvImpostor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="serif"
        android:letterSpacing="0.12"
        android:text="@string/splash_impostor"
        android:textColor="#F2D0D8"
        android:textSize="36sp"
        android:textStyle="bold"
        android:shadowColor="#66D92C58"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="20"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sceneContainer" />

    <LinearLayout
        android:id="@+id/sceneContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/titleBlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.38">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/arrow0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:alpha="0.92"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_right"
                app:tint="#F0D0D7"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/arrow1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:alpha="0.92"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_right"
                app:tint="#F0D0D7"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/arrow2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:alpha="0.92"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_right"
                app:tint="#F0D0D7"
                android:visibility="invisible" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/arrow4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:alpha="0.92"
                android:scaleType="fitCenter"
                android:scaleX="-1"
                android:src="@drawable/ic_arrow_right"
                app:tint="#F0D0D7"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/arrow5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:alpha="0.92"
                android:scaleType="fitCenter"
                android:scaleX="-1"
                android:src="@drawable/ic_arrow_right"
                app:tint="#F0D0D7"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/char0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/civil1" />

            <ImageView
                android:id="@+id/char1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/civil2" />

            <ImageView
                android:id="@+id/char2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/civil3" />

            <ImageView
                android:id="@+id/char3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/impostor" />

            <ImageView
                android:id="@+id/char4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/civil4" />

            <ImageView
                android:id="@+id/char5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/civil5" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/titleBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/loadingContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sceneContainer"
        app:layout_constraintVertical_bias="0.42">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="@string/staicy_edition"
            android:textColor="#A6F0D0D7"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.22"
            android:text="@string/splash_title"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:shadowColor="#55D92C58"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="16" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/loadingContainer"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/loadingTrack"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_loading_track_deep_terminal" />

        <View
            android:id="@+id/loadingFill"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_loading_fill_deep_terminal"
            android:scaleX="0" />

        <ImageView
            android:id="@+id/loadingIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="start|bottom"
            android:layout_marginBottom="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/impostor" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
