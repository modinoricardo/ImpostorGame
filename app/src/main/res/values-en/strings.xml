    <!-- AcercaDeBottomSheet -->
    <string name="acerca_titulo">About</string>
    <string name="acerca_creador">Creator of Catch the Impostor</string>
    <string name="acerca_descripcion">This game was born without profit motives and with a single intention: for people to laugh, be surprised and have a good time together, as I myself have had the pleasure of enjoying.</string>
    <string name="acerca_uso">Use it, share it and enjoy it without limits — the only thing I ask is that you play it in good company.</string>
    <string name="acerca_frase">It\'s not a game to win. It\'s a game to connect.</string>
    <string name="acerca_agradecimiento">Special thanks to the person who drives and inspires me to create projects like this, and who always supports me every step of the way: Ste.H. Without you, none of this would make the same sense.</string>
    <string name="acerca_abrazo">A hug to everyone who plays it.</string>
