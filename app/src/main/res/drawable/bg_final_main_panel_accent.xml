<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="27dp" />
            <solid android:color="#1400E5FF" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#1A202C"
                android:centerColor="#121824"
                android:endColor="#0C111A" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#4600E5FF" />
        </shape>
    </item>
</layer-list>
