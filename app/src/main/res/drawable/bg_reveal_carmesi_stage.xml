<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#170D12" />
            <stroke
                android:width="1dp"
                android:color="#24E5CED4" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient
                android:angle="315"
                android:startColor="#1CD92C58"
                android:centerColor="#110B10"
                android:endColor="#120D11"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="90"
                android:startColor="#12FFFFFF"
                android:centerColor="#04F0D8DE"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
