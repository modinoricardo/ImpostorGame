<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#2C0E16" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#7FF2D3DA" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape>
            <gradient
                android:angle="90"
                android:centerColor="#81203D"
                android:endColor="#431523"
                android:startColor="#561A2B"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
