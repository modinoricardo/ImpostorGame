<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#190E13" />
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#20686066" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape>
                    <gradient
                        android:angle="90"
                        android:endColor="#28161D"
                        android:startColor="#341D25"
                        android:type="linear" />
                    <corners android:radius="17dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#551225" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape>
                    <gradient
                        android:angle="90"
                        android:centerColor="#C42A53"
                        android:endColor="#781734"
                        android:startColor="#931C3F"
                        android:type="linear" />
                    <corners android:radius="17dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#99FFECEF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#220A10" />
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#3EF3D3DA" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape>
                    <gradient
                        android:angle="90"
                        android:centerColor="#D92C58"
                        android:endColor="#7D1838"
                        android:startColor="#9E2146"
                        android:type="linear" />
                    <corners android:radius="17dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#66FFF1F4" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
