<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#111111"/>
                    <corners android:radius="22dp"/>
                    <stroke android:width="1dp" android:color="#22FFFFFF"/>
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape>
                    <solid android:color="#0A0A0A"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#333333"/>
                    <corners android:radius="22dp"/>
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape>
                    <solid android:color="#1A1A1A"/>
                    <corners android:radius="20dp"/>
                    <stroke android:width="1dp" android:color="#BBFFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#1A1A1A"/>
                    <corners android:radius="22dp"/>
                    <stroke android:width="1dp" android:color="@color/deep_terminal_stroke"/>
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape>
                    <solid android:color="#111111"/>
                    <corners android:radius="20dp"/>
                    <stroke android:width="1dp" android:color="@color/deep_terminal_stroke"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
