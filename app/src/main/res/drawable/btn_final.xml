<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Glow cian exterior -->
    <item>
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#2000E5FF" />
        </shape>
    </item>

    <!-- Cuerpo del botón: oscuro con borde cian -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape>
            <corners android:radius="16dp" />
            <gradient
                android:angle="90"
                android:startColor="#0D1117"
                android:centerColor="#111520"
                android:endColor="#0A0F1A"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#6000E5FF" />
        </shape>
    </item>

</layer-list>
