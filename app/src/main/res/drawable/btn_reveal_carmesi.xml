<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#B91F48"
                android:centerColor="#9E173C"
                android:endColor="#861333"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#72FFDDE5" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#D92C58"
                android:centerColor="#BE214B"
                android:endColor="#99173A"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#4CFFE3EA" />
        </shape>
    </item>
</selector>
