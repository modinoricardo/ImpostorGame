<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#741A35"
                android:startColor="#992446"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#88FFF0F2" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#26181E"
                android:startColor="#352127"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/carmesi_stroke_soft" />
        </shape>
    </item>
</selector>
