<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base profunda con más matiz que el fondo anterior -->
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#1A2D4F"
                android:centerColor="#0B172C"
                android:endColor="#040914" />
        </shape>
    </item>

    <!-- Halo frío superior -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#2400E5FF"
                android:centerColor="#0800E5FF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Veladura lateral para dar algo de atmósfera -->
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#1800D1FF"
                android:centerColor="#0A12314B"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Contrapeso inferior para que no quede seco -->
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#14000000"
                android:centerColor="#10132A46"
                android:endColor="#24020812" />
        </shape>
    </item>

    <!-- Viñeta suave para mantener legibilidad -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#00000000"
                android:centerColor="#08000000"
                android:endColor="#2A01040B" />
        </shape>
    </item>

</layer-list>
