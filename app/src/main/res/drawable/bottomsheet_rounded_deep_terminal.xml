<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/deep_terminal_bg"/>
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp"/>
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape>
            <solid android:color="@color/deep_terminal_surface"/>
            <corners android:topLeftRadius="23dp" android:topRightRadius="23dp"/>
            <stroke android:width="1dp" android:color="@color/deep_terminal_stroke_soft"/>
        </shape>
    </item>
</layer-list>
