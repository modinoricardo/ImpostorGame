<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#0E080A"
                android:startColor="#140B0E" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#21141A"
                android:startColor="#2A1820" />
            <corners
                android:topLeftRadius="23dp"
                android:topRightRadius="23dp" />
            <stroke
                android:width="1dp"
                android:color="@color/carmesi_stroke_soft" />
        </shape>
    </item>
</layer-list>
