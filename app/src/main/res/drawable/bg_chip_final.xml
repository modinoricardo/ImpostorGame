<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#16E7C87D" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#2A221B"
                android:endColor="#171219" />
            <corners android:radius="19dp" />
            <stroke
                android:width="1dp"
                android:color="#72E7C87D" />
        </shape>
    </item>
</layer-list>
