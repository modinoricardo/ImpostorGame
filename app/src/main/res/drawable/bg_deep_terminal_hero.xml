<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/deep_terminal_bg"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item android:top="-40dp" android:left="-40dp">
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="50%p"
                android:startColor="#12FFFFFF"
                android:endColor="#00000000"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/deep_terminal_stroke"/>
        </shape>
    </item>
</layer-list>
