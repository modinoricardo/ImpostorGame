<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/deep_terminal_bg"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape>
            <solid android:color="@color/deep_terminal_surface"/>
            <corners android:radius="17dp"/>
            <stroke android:width="1.5dp" android:color="@color/deep_terminal_accent"/>
        </shape>
    </item>
</layer-list>
