<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#1C0C12" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <gradient
                android:angle="90"
                android:centerColor="#B8254B"
                android:endColor="#5E1730"
                android:startColor="#85233F"
                android:type="linear" />
            <corners android:radius="17dp" />
            <stroke
                android:width="1dp"
                android:color="#7ADFD1D4" />
        </shape>
    </item>

    <item
        android:bottom="34dp"
        android:left="14dp"
        android:right="14dp"
        android:top="2dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#00FFF4F5"
                android:startColor="#12FFF4F5"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
