<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/deep_terminal_panel_shadow"/>
            <corners android:radius="22dp"/>
            <stroke android:width="1dp" android:color="@color/deep_terminal_stroke_soft"/>
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="@color/deep_terminal_surface_alt"
                android:centerColor="@color/deep_terminal_surface"
                android:endColor="@color/deep_terminal_bg_alt"
                android:type="linear"/>
            <corners android:radius="21dp"/>
            <stroke android:width="1dp" android:color="@color/deep_terminal_stroke_soft"/>
        </shape>
    </item>
</layer-list>
