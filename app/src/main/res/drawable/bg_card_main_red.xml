<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/carmesi_panel_shadow" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="@color/carmesi_stroke_soft" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <gradient
                android:angle="90"
                android:centerColor="@color/carmesi_surface"
                android:endColor="@color/carmesi_surface_soft"
                android:startColor="@color/carmesi_surface_alt"
                android:type="linear" />
            <corners android:radius="21dp" />
            <stroke
                android:width="1dp"
                android:color="@color/carmesi_stroke_soft" />
        </shape>
    </item>

    <item
        android:bottom="46dp"
        android:left="16dp"
        android:right="16dp"
        android:top="2dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#12FFF4F6"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
