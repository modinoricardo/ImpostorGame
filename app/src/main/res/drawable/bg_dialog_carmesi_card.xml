<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#17070C" />
            <corners android:radius="30dp" />
            <stroke
                android:width="1dp"
                android:color="#45F1C7D0" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#241018"
                android:startColor="#31111C" />
            <corners android:radius="29dp" />
            <stroke
                android:width="1dp"
                android:color="#26D92C58" />
        </shape>
    </item>
</layer-list>
