<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#10080B"
                android:startColor="#170C10" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#1D1217"
                android:startColor="#2A1820" />
            <corners
                android:topLeftRadius="23dp"
                android:topRightRadius="23dp" />
            <stroke
                android:width="1dp"
                android:color="@color/carmesi_stroke_soft" />
        </shape>
    </item>

    <item
        android:bottom="46dp"
        android:left="18dp"
        android:right="18dp"
        android:top="2dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#0EFFF1F4"
                android:type="linear" />
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp" />
        </shape>
    </item>
</layer-list>
