<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="#24151B" />
            <stroke
                android:width="1dp"
                android:color="#32F0D9DE" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <gradient
                android:angle="270"
                android:startColor="#30D92C58"
                android:centerColor="#171015"
                android:endColor="#110B10"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="90"
                android:startColor="#16FFF2F4"
                android:centerColor="#08F0D7DD"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:left="18dp"
        android:top="18dp"
        android:right="18dp"
        android:bottom="18dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#14F0D9DE" />
        </shape>
    </item>
</layer-list>
