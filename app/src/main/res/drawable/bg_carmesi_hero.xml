<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:centerColor="#311C23"
                android:endColor="#170F13"
                android:startColor="#471B29"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="@color/carmesi_stroke" />
        </shape>
    </item>

    <item
        android:bottom="58dp"
        android:left="18dp"
        android:right="18dp"
        android:top="2dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#10FFF5F7"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
