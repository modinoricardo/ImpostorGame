<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.ImpostorGame" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:textViewStyle">@style/ImpostorGame.TextView</item>
    </style>

    <style name="Theme.ImpostorGame" parent="Base.Theme.ImpostorGame">
        <item name="colorPrimary">#00E5FF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.ImpostorGame_Carmesi" parent="Base.Theme.ImpostorGame">
        <item name="colorPrimary">@color/carmesi_accent</item>
        <item name="colorOnPrimary">@color/carmesi_text_primary</item>
        <item name="colorSecondary">@color/carmesi_rose</item>
        <item name="colorOnSecondary">@color/carmesi_primary_dark</item>
        <item name="colorSurface">@color/carmesi_surface</item>
        <item name="colorOnSurface">@color/carmesi_text_primary</item>
        <item name="android:colorBackground">@color/carmesi_primary_dark</item>
        <item name="android:textColorPrimary">@color/carmesi_text_primary</item>
        <item name="android:textColorSecondary">@color/carmesi_text_secondary</item>
        <item name="android:textColorHint">@color/carmesi_text_muted</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ImpostorGame.Carmesi.AlertDialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/carmesi_bg_top</item>
    </style>

    <style name="Theme.ImpostorGame_Jmc" parent="Base.Theme.ImpostorGame">
        <item name="colorPrimary">#00C853</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Theme para el BottomSheet -->
    <style name="Theme.EditPlayersBottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowEnterAnimation">@anim/bottomsheet_material_in</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/Widget.ImpostorGame.BottomSheet</item>
    </style>

    <style name="Widget.ImpostorGame.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="paddingLeftSystemWindowInsets">false</item>
        <item name="paddingRightSystemWindowInsets">false</item>
    </style>

    <style name="ThemeOverlay.ImpostorGame.Carmesi.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/carmesi_accent</item>
        <item name="colorSurface">@color/carmesi_surface</item>
        <item name="backgroundTint">@color/carmesi_surface</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.ImpostorGame.Carmesi.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.ImpostorGame.Carmesi.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ImpostorGame.Carmesi.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ImpostorGame.Carmesi.DialogButton.Secondary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.ImpostorGame.Carmesi.Dialog</item>
    </style>

    <style name="TextAppearance.ImpostorGame.Carmesi.Dialog.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/carmesi_text_primary</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="TextAppearance.ImpostorGame.Carmesi.Dialog.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/carmesi_text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.ImpostorGame.Carmesi.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/carmesi_rose</item>
    </style>

    <style name="Widget.ImpostorGame.Carmesi.DialogButton.Secondary" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/carmesi_text_secondary</item>
    </style>

    <style name="ShapeAppearance.ImpostorGame.Carmesi.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>



</resources>
